on init
    chown system system /dev/goodix_fp
    chmod 0660 /dev/goodix_fp
    mkdir /data/vendor/goodix 0770 system system

on boot
    chown system system /sys/bus/platform/devices/soc/soc:fpc1020/compatible_all
    chown system system /sys/bus/platform/devices/soc/soc:fpc1020/irq
    chown system system /sys/bus/platform/devices/soc/soc:fpc1020/hw_reset
    chown system system /sys/bus/platform/devices/soc/soc:fpc1020/wakeup_enable
    chown system system /sys/bus/platform/devices/soc/soc:fpc1020/fingerdown_wait
    chmod 0660 /sys/bus/platform/devices/soc/soc:fpc1020/compatible_all
    chmod 0660 /sys/bus/platform/devices/soc/soc:fpc1020/irq
    chmod 0660 /sys/bus/platform/devices/soc/soc:fpc1020/hw_reset
    chmod 0660 /sys/bus/platform/devices/soc/soc:fpc1020/wakeup_enable
    chmod 0660 /sys/bus/platform/devices/soc/soc:fpc1020/fingerdown_wait

    chown system system /dev/focaltech_fp
    chmod 0660 /dev/focaltech_fp

    chown system system /dev/fpsdev0
    chmod 0660 /dev/fpsdev0

    restorecon /data/vendor/focaltech

on post-fs-data
    mkdir /data/vendor/focaltech 0770 system system
    mkdir /data/vendor/goodix 0770 system system
    mkdir /data/vendor/silead 0770 system system
